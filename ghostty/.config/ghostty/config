# Font
font-family = "JetBrains Mono Nerd Font"
font-size = 14

# Window
adjust-cell-height = 25%
macos-non-native-fullscreen = true
macos-titlebar-style = transparent
window-padding-balance = true
window-padding-x = 15
window-padding-y = 10
resize-overlay = never
mouse-hide-while-typing = true

# Shell integration
shell-integration = detect

# Don't confirm when closing a window with no running process
confirm-close-surface = false

# Clipboard
clipboard-read = allow
clipboard-write = allow
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Cmd key → Unicode passthrough for tmux bindings
# Ghostty maps Cmd+key to a unique Unicode character that tmux can bind to
keybind = super+n=text:ç
keybind = super+r=text:÷
keybind = super+shift+bracket_left=text:˙
keybind = super+shift+bracket_right=text:¬
keybind = super+z=text:⌟
keybind = super+p=text:▸
keybind = super+o=text:⌁
keybind = super+i=text:◈
keybind = super+u=text:≈
